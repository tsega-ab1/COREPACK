# Copy to deploy/.env and fill in. Never commit the real file.
DOMAIN=gateway.example.com
COREPACK_TOKEN=put-a-long-random-owner-token-here
COREPACK_PROVIDER=gemini
COREPACK_MODEL=put-the-model-name-here
COREPACK_API_KEY=your-shared-key-for-testers
# Output of: corepack gateway invite export
COREPACK_INVITES={}
COREPACK_INVITE_RPM=6
COREPACK_INVITE_DAILY=30
